<% content_for :title, "Stakkd - #{@relatable} crew members" %>

<%= render "#{relatable_model_plural}/header", @relatable.related_records %>

<div class="max-w-7xl mx-auto my-8 px-6">
  <div class="form">
    <%= render "#{relatable_model_plural}/form_nav", @relatable.related_records %>

    <%= render "shared/table_editor", table_presenter: @table_presenter, path_prefix: nested_path_for(relatable: @relatable) %>

    <%= form_with model: @relatable.records_for_polymorphic_paths + [CrewMember.new] do |form| %>
      <h4 class="font-bold text-2xl">Add a crew member</h4>

      <div class="flex flex-col sm:flex-row gap-6">
        <div class="basis-full sm:basis-1/2 relative">
          <%= form.label :person_id %>
          <%= form.text_field :person_id,
                required: true,
                autocomplete: "off",
                data: {
                  controller: "ajax-search",
                  ajax_search_query_by_value: "original_name,translated_name,aka",
                  ajax_search_collection_name_value: "Person",
                  ajax_search_display_attributes_value: "[\"translated_name\"]"
                } %>
          <div class="search-input"></div>
          <div class="search-results"></div>
        </div>

        <div class="basis-full sm:basis-1/2 relative">
          <%= form.label :job_id %>
          <%= form.text_field :job_id,
                required: true,
                autocomplete: "off",
                data: {
                  controller: "ajax-search",
                  ajax_search_query_by_value: "name,department",
                  ajax_search_collection_name_value: "Job",
                  ajax_search_display_attributes_value: "[\"department\", \"name\"]"
                } %>
          <div class="search-input"></div>
          <div class="search-results"></div>
        </div>
      </div>

      <div>
        <%= form.submit "Save" %>
      </div>
    <% end %>
  </div>
</div>
