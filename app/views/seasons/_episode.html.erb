<% watchlisted = @watchlisted_episodes.include?(episode) %>
<div class="grid grid-cols-1 md:grid-cols-3">
  <div class="col-span-1 relative">
    <%= link_to show_season_episode_path(episode, season_id: @season, show_id: @show), class: "block w-full relative" do %>
      <% if watchlisted %>
        <i class="fa-solid fa-bookmark absolute z-1 right-0 top-0 w-8 h-8 rounded-full bg-pop/75 text-center p-2 mr-2 mt-2"></i>
      <% end %>
      <%= image_tag episode.background(variant: :small), class: "w-full rounded-lg md:rounded-r-none border border-pop aspect-[16/9]" %>
    <% end %>
    <% if authenticated? %>
      <%= render "shared/actions/buttons/rating",
            record: episode,
            score: @rating_scores[episode],
            context: "#{@show.translated_title} · #{@season.translated_name}, Episode #{episode.number}" %>
    <% end %>
  </div>
  <div class="col-span-1 md:col-span-2">
    <div class="flex flex-col sm:flex-row justify-between gap-4 bg-background-darker md:border md:border-pop md:border-l-0 p-4 rounded-lg md:rounded-l-none">
      <div class="flex flex-wrap items-center gap-2">
        <%= link_to show_season_episode_path(episode, season_id: @season, show_id: @show), class: "font-domine hover:underline decoration-pop" do %>
          <b class="text-pop">Episode <%= episode.number %></b> - <%= episode.translated_name %>
        <% end %>
        <% unless episode.standard? %>
          <small class="py-1 px-2 bg-pop/50 rounded-lg whitespace-nowrap"><%= episode.episode_type %></small>
        <% end %>
      </div>
      <div class="w-40">
        <% watch_status = @episode_watch_statuses[episode] || :none %>
        <%= render "shared/actions/compact_actions", record: episode, collection_status: @collection_statuses[episode], watch_status: watch_status, watchlisted: watchlisted %>
      </div>
    </div>
    <p class="px-4 pt-2 text-sm line-clamp-2 sm:line-clamp-3 md:line-clamp-4"><%= episode.overview %></p>

    <p class="px-4 pt-2 text-sm"><%= episode.original_air_date&.strftime("%B %d, %Y") || "Unknown air date" %> - <%= format_runtime(episode) %></p>
  </div>
</div>
