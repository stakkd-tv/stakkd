<%= turbo_frame_tag dom_id(@season, :collection), class: "block px-4 pb-4 dim-while-busy" do %>
  <% @entries.each do |entry| %>
    <div class="flex items-start justify-between gap-2 py-4 border-t border-white/15" id="<%= dom_id(entry) %>">
      <div class="min-w-0">
        <%= link_to "E#{entry.item.number} · #{entry.item.translated_name}", polymorphic_record_path(entry.item, nil), class: "underline", data: {turbo_frame: "_top"} %>
        <div class="flex flex-wrap gap-2 mt-2">
          <% entry.formats.sort_by { it.name.downcase }.each do |format| %>
            <span class="bg-background rounded py-1 px-2 text-xs"><%= format.name %></span>
          <% end %>
          <% if entry.formats.empty? %>
            <span class="bg-background rounded py-1 px-2 text-xs">No format specified</span>
          <% end %>
        </div>
        <p class="text-xs text-white/75 mt-2">Added <%= entry.created_at.strftime("%d %b %Y") %></p>
      </div>
      <%= render "users/collections/removal_menu", record: entry.item, title: entry.item.translated_name, card_selector: "##{dom_id(entry)}" if current_user == @user %>
    </div>
  <% end %>
  <div class="flex gap-4 justify-between text-sm">
    <% if @entries.previous_page %>
      <%= link_to user_collection_season_path(@user, @show, @season.number, **@collection_query.to_params, page: @entries.previous_page), class: "inline-flex items-center gap-2 underline" do %>
        <i class="fa-solid fa-arrow-left" aria-hidden="true"></i>
        Previous episodes
      <% end %>
    <% end %>
    <% if @entries.next_page %>
      <%= link_to user_collection_season_path(@user, @show, @season.number, **@collection_query.to_params, page: @entries.next_page), class: "inline-flex items-center gap-2 underline ml-auto" do %>
        More episodes
        <i class="fa-solid fa-arrow-right" aria-hidden="true"></i>
      <% end %>
    <% end %>
  </div>
<% end %>
