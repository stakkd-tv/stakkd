<% current_month = nil %>
<% ratings.each do |rating| %>
  <% month = rating.updated_at.to_date.beginning_of_month %>
  <% if @ratings_query.chronological? && month.iso8601 != current_month %>
    <% current_month = month.iso8601 %>
    <div data-rating-month="<%= current_month %>" class="col-span-full items-center gap-4 hidden in-data-[show-dates=true]:flex">
      <h3 class="text-xl font-fugaz shrink-0"><%= month.strftime("%B %Y") %></h3>
      <span class="h-1 flex-1 bg-background-darker"></span>
    </div>
  <% end %>
  <%= render "item", entry: RatingPresenter.new(rating) %>
<% end %>
