<div class="rounded-lg border-2 border-pop overflow-hidden mb-8">
  <div class="p-8 flex gap-8 relative">
    <% if user.background.attached? %>
      <div class="absolute left-0 top-0 -z-1 w-full h-full overflow-hidden">
        <%= image_tag user.background, alt: "Background", class: "blur-sm w-full h-full object-cover object-center" %>
        <div class="absolute left-0 top-0 bg-black/75 w-full h-full"></div>
      </div>
    <% end %>
    <div class="min-w-14 w-14 h-14 md:w-24 md:h-24 aspect-square overflow-hidden rounded-full outline-3 outline-pop">
      <%= image_tag user.avatar, alt: "Avatar", class: "w-full h-full object-cover object-center" %>
    </div>
    <div class="flex flex-col gap-1 md:gap-2">
      <h1 class="text-2xl md:text-4xl font-bold font-domine"><%= user.username %></h1>
      <p class="text-sm md:text-md">Member since <%= user.created_at.strftime("%d %B %Y") %></p>
    </div>
  </div>
  <div class="form-nav flex flex-wrap gap-2 px-8 py-3 border-b-0 border-t-2 border-t-pop">
    <% if user.private? && current_user != user %>
      <h4>This user's profile is private. You won't be able to see their activity unless they accept your follow request.</h4>
    <% else %>
      <%= render "users/nav_links", user: user %>
    <% end %>
  </div>
</div>
