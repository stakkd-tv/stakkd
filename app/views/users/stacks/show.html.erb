<% content_for :title, "Stakkd - #{@stack.name}" %>

<div class="max-w-7xl mx-auto my-8 px-6 pt-10">
  <%= render "users/compact_header", user: @user %>

  <div class="bg-background-darker rounded-lg p-4 mb-8">
    <div class="flex justify-between gap-4">
      <h4 class="text-xl sm:text-2xl font-bold font-domine <%= "stack_#{@stack.id}_name" %>">
        <%= @stack.name %>
      </h4>
      <% if @stack.user == current_user %>
        <button data-controller="edit-stack-button"
          data-edit-stack-button-update-stack-url-value="<%= user_stack_path(@stack, user_id: @user) %>"
          data-edit-stack-button-stack-id-value="<%= @stack.id %>"
          data-edit-stack-button-name-value="<%= @stack.name %>"
          data-edit-stack-button-description-value="<%= @stack.description %>"
          data-edit-stack-button-sorting-method-value="<%= @stack.sorting_method %>"
          data-edit-stack-button-sorting-direction-value="<%= @stack.sorting_direction %>"
          data-edit-stack-button-private-value="<%= @stack.private %>"
          data-action="edit-stack-button#open edit-stack-dialog:updated-stack@window->edit-stack-button#update"
          class="h-fit cursor-pointer inline-block">
          <i class="fa-solid fa-pen"></i>
        </button>
      <% end %>
    </div>
    <p class="text-sm text-gray-300 mt-2 <%= "stack_#{@stack.id}_description" %>">
      <%= @stack.description %>
    </p>
    <p class="text-sm text-gray-300 mt-2"><%= pluralize(@stack.stack_items.count, "item") %></p>
    <hr class="my-4 border-t-3 border-background">
    <div class="flex gap-2 items-center">
      <%= select_tag :sort,
            options_for_select(
              Stack::SORTING_METHODS.map { [it.humanize, it] },
              @stack.sorting_method
            ),
            class: "input p-1.5 text-sm max-w-50 w-full cursor-pointer",
            autocomplete: "off" %>
      <i data-direction="<%= @stack.sorting_direction %>" class="fa-solid fa-arrow-up mx-2 text-xl cursor-pointer data-[direction=desc]:rotate-180"></i>
    </div>
  </div>

  <div id="stack_items" class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-4">
    <% @stack_items.each do |stack_item| %>
      <div class="p-4 bg-background-darker rounded-lg flex flex-col gap-4 relative group StackItem_<%= stack_item.id %>_card">
        <div class="flex flex-col md:flex-row gap-4">
          <% if stack_item.item.respond_to?(:poster) %>
            <%= link_to polymorphic_record_path(stack_item.item, nil), class: "w-fit" do %>
              <div class="h-fit min-w-30 max-w-30 aspect-2/3 border border-pop outline outline-transparent group-hover:outline-pop rounded-lg overflow-hidden transition duration-300 ease-in-out">
                <%= image_tag stack_item.item.poster(variant: :small),
                      class: "w-full",
                      title: stack_item.item %>
              </div>
            <% end %>
          <% end %>
          <div>
            <%= link_to polymorphic_record_path(stack_item.item, nil), class: "inline-block max-w-9/10" do %>
              <h5 class="text-md font-domine font-bold line-clamp-2 mb-2">
                <%= stack_item.item %>
              </h5>
            <% end %>
            <small class="text-xs text-gray-300 line-clamp-4 leading-4 mb-2">
              <%= stack_item.item.overview %>
            </small>
            <small class="text-xs line-clamp-2">
              Added: <%= stack_item.added_at.strftime("%b %d, %Y %H:%M") %>
            </small>
          </div>
        </div>
        <% watch_status = @watch_statuses[stack_item.item] || :not_consumed %>
        <%= render "shared/actions/compact_actions", record: stack_item.item, watch_status: watch_status %>

        <% if @stack.user === current_user %>
          <button class="h-fit absolute top-0 right-0 my-3 mx-4"
            data-controller="deletion-button"
            data-action="deletion-button#open deletion-dialog:deleted@window->deletion-button#removeElementFromDOM"
            data-deletion-button-card-element-selector-value="<%= ".StackItem_#{stack_item.id}_card" %>"
            data-deletion-button-delete-record-url-value="<%= user_stack_stack_item_path(stack_item, stack_id: @stack, user_id: current_user) %>">
            <i class="fa-solid fa-xmark cursor-pointer"></i>
          </button>
        <% end %>
      </div>
    <% end %>
  </div>
</div>
