<% content_for :title, "Stakkd - Franchises" %>

<div class="max-w-7xl mx-auto my-28 px-6">
  <div class="flex gap-8 justify-between flex-col sm:flex-row w-full mt-28 mb-10">
    <h3 class="text-4xl font-bold font-domine text-white text-center">Franchises</h3>
    <%= link_to "Add a franchise", new_franchise_path, class: "link" %>
  </div>
  <div class="grid grid-cols-1 md:grid-cols-4 md:gap-8 md:min-h-screen">
    <%= form_with(url: franchises_path, method: "get", class: "col-span-1 flex flex-col gap-5 items-center md:items-start", data: {turbo_frame: "franchises_filter_results"}) do |form| %>
      <details class="bg-background-darker w-full rounded-lg mb-4" data-auto-open>
        <summary class="p-4 cursor-pointer border-b-2 border-background"><span class="ml-2">Filters</span></summary>
        <div class="flex flex-col">
          <div class="p-4 border-b-2 border-background flex flex-col gap-4">
            <p><b>Release dates</b></p>
            <div class="flex flex-col gap-1">
              <label for="release_dates_from" class="basis-1/4">From</label>
              <input type="date" name="release_dates_from" class="input" autocomplete="off" value="<%= params[:release_dates_from] || "" %>">
            </div>
            <div class="flex flex-col gap-1">
              <label for="release_dates_to" class="basis-1/4">To</label>
              <input type="date" name="release_dates_to" class="input" autocomplete="off" value="<%= params[:release_dates_to] || "" %>">
            </div>
          </div>

          <div class="p-4 border-b-2 border-background">
            <%= submit_tag "Apply filter", class: "link w-full" %>
          </div>
        </div>
      </details>
    <% end %>
    <div class="col-span-3">
      <%= turbo_frame_tag "franchises_filter_results" do %>
        <%= turbo_frame_tag "franchises", class: "grid grid-cols-2 md:grid-cols-3 gap-4" do %>
          <% @franchises.each do |franchise| %>
            <%= render franchise %>
          <% end %>
        <% end %>
        <% if @franchises.any? && @franchises.next_page.present? %>
          <%= render "load_more" %>
        <% end %>
      <% end %>
    </div>
  </div>
</div>
