<%= turbo_stream.append "franchises" do %>
  <% @franchises.each do |franchise| %>
    <%= render franchise %>
  <% end %>
<% end %>

<% if @franchises.next_page.present? %>
  <%= turbo_stream.replace "load_more" do %>
    <%= render "load_more" %>
  <% end %>
<% else %>
  <%= turbo_stream.remove "load_more" %>
<% end %>
