<% if authenticated? %>
  <% watch_status = local_assigns.fetch(:watch_status, :not_consumed) %>
  <div class="flex gap-2 bg-background-darker p-2 border-2 border-pop rounded-xl w-fit relative">
    <%= render "shared/actions/buttons/add_to_history", record: record, watch_status: watch_status %>

    <button class="z-1 cursor-pointer p-2 h-full min-w-10.5 aspect-square rounded-lg focus:bg-black/75 hover:bg-black/75 transition-all duration-300 ease-in-out" title="Add to watchlist">
      <i class="fa-regular fa-bookmark text-xl transition-all duration-300 ease-in-out"></i>
    </button>

    <button class="z-1 cursor-pointer p-2 h-full min-w-10.5 aspect-square rounded-lg focus:bg-black/75 hover:bg-black/75 transition-all duration-300 ease-in-out" title="Add to collection">
      <i class="fa-regular fa-folder text-xl transition-all duration-300 ease-in-out"></i>
    </button>

    <button
      class="z-1 cursor-pointer p-2 h-full min-w-10.5 aspect-square rounded-lg border border-transparent focus:bg-black/75 hover:bg-black/75 transition-all duration-300 ease-in-out"
      title="More options"
      data-controller="more-options"
      data-more-options-selector-value="#actions-more-options"
      id="<%= "#{record.class}_#{record.id}_more_options" %>">
      <i class="fa-solid fa-ellipsis-vertical text-xl transition-all duration-300 ease-in-out"></i>
    </button>

    <% desktop = "sm:-left-[2px] sm:w-[calc(100%+4px)]" %>
    <% mobile = "-left-[1.75px] w-[calc(100%+3.5px)]" %>
    <% classes = "opacity-0 pointer-events-none transition-all duration-300 ease-in-out absolute top-[calc(100%-9px)] #{mobile} #{desktop} -mt-[1px] bg-background-darker border-r-2 border-l-2 border-b-2 border-pop rounded-b-xl flex flex-col gap-2 p-2 pt-3" %>
    <div class="<%= classes %>" id="actions-more-options">
      <%= link_to "#", class: "link w-full" do %>
        <i class="fa-solid fa-clock mr-2"></i>
        View history
      <% end %>

      <%= render "shared/actions/buttons/add_to_stack", record: record %>

      <%= link_to "#", class: "link w-full" do %>
        <i class="fa-solid fa-share mr-2"></i>
        Share
      <% end %>

      <%= link_to "#", class: "link w-full" do %>
        <i class="fa-solid fa-flag mr-2"></i>
        Report
      <% end %>
    </div>
  </div>
<% end %>
