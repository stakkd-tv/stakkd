<div class="flex gap-2 bg-background-darker p-2 border border-pop rounded-lg w-fit">
  <button class="cursor-pointer border border-watch p-2 w-20 sm:w-40 rounded-md hover:bg-watch/75 transition-all duration-300 ease-in-out" title="Mark as watched">
    <i class="fa-regular fa-square-check text-xl transition-all duration-300 ease-in-out"></i>
  </button>
  <button class="cursor-pointer p-2 h-full min-w-10.5 aspect-square rounded-md hover:bg-black/75 transition-all duration-300 ease-in-out" title="Add to watchlist">
    <i class="fa-regular fa-bookmark text-xl transition-all duration-300 ease-in-out"></i>
  </button>
  <button class="cursor-pointer p-2 h-full min-w-10.5 aspect-square rounded-md hover:bg-black/75 transition-all duration-300 ease-in-out" title="Add to collection">
    <i class="fa-regular fa-folder text-xl transition-all duration-300 ease-in-out"></i>
  </button>
  <button class="cursor-pointer p-2 h-full min-w-10.5 aspect-square rounded-md hover:bg-black/75 transition-all duration-300 ease-in-out" title="More options">
    <i class="fa-solid fa-ellipsis-vertical text-xl transition-all duration-300 ease-in-out"></i>
  </button>
</div>
