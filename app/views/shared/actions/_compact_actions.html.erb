<% if authenticated? %>
  <% watch_status = local_assigns.fetch(:watch_status, :not_consumed) %>
  <% selector = "#{record.class}-#{record.id}-more-options" %>
  <div class="flex gap-2 w-full sm:relative">
    <button
      class="data-[status=partially\_consumed]:bg-watch/50 data-[status=consumed]:bg-watch cursor-pointer border border-watch p-2 w-20 sm:w-40 rounded-lg disabled:border-white disabled:hover:bg-background-darker disabled:cursor-default focus:bg-watch/75 hover:bg-watch/75 transition-all duration-300 ease-in-out"
      title="Add to history"
      data-record-type="<%= record.class.polymorphic_name %>"
      data-record-id="<%= record.id %>"
      data-status="<%= watch_status %>"
      data-controller="history-button"
      data-action="history-button#open history-dialog:status-update@window->history-button#updateStatus"
      data-history-button-add-to-history-url-value="<%= polymorphic_record_path(record, "add_to_history") %>"
      data-history-button-remove-from-history-url-value="<%= polymorphic_record_path(record, "remove_from_history") %>"
      <%= record.released? ? "" : "disabled" %>>
      <i class="fa-regular fa-square-check text-xl transition-all duration-300 ease-in-out"></i>
    </button>

    <button
      class="cursor-pointer p-2 h-full min-w-10.5 aspect-square rounded-lg border border-transparent focus:bg-black/75 hover:bg-black/75 transition-all duration-300 ease-in-out"
      title="More options"
      data-controller="more-options"
      data-more-options-selector-value=".<%= selector %>"
      id="<%= "#{record.class}_#{record.id}_more_options" %>">
      <i class="fa-solid fa-ellipsis-vertical text-xl transition-all duration-300 ease-in-out"></i>
    </button>

    <div class="<%= selector %> mt-2 z-1 opacity-0 pointer-events-none transition-all duration-300 ease-in-out fixed sm:absolute bottom-0 left-0 h-fit w-full sm:w-50 sm:top-full sm:right-0 sm:left-auto flex flex-col gap-2 p-2 bg-background-darker border-t-2 sm:border-2 border-pop sm:rounded-lg">
      <p class="sm:hidden text-xl font-domine my-4"><%= record %></p>

      <%= link_to "#", class: "link w-full" do %>
        <i class="fa-solid fa-clock mr-2"></i>
        View history
      <% end %>

      <%= link_to "#", class: "link w-full" do %>
        <i class="fa-regular fa-bookmark mr-2"></i>
        Add to watchlist
      <% end %>

      <%= link_to "#", class: "link w-full" do %>
        <i class="fa-regular fa-folder mr-2"></i>
        Add to collection
      <% end %>

      <%= render "shared/actions/buttons/add_to_stack", record: record %>

      <%= link_to "#", class: "link w-full" do %>
        <i class="fa-solid fa-share mr-2"></i>
        Share
      <% end %>

      <%= link_to "#", class: "link w-full" do %>
        <i class="fa-solid fa-flag mr-2"></i>
        Report
      <% end %>
    </div>
  </div>
<% end %>
