<% if authenticated? %>
  <% watch_status = local_assigns.fetch(:watch_status, :not_consumed) %>
  <% selector = "#{record.class}-#{record.id}-more-options" %>
  <div class="flex gap-2 w-full sm:relative">
    <%= render "shared/actions/buttons/add_to_history", record: record, watch_status: watch_status %>

    <%= render "shared/actions/buttons/more_options", selector: ".#{selector}", record: record %>

    <div class="<%= selector %> mt-2 z-1 opacity-0 pointer-events-none transition-all duration-300 ease-in-out fixed sm:absolute bottom-0 left-0 h-fit w-full sm:w-50 sm:top-full sm:right-0 sm:left-auto flex flex-col gap-2 p-2 bg-background-darker border-t-2 sm:border-2 border-pop sm:rounded-lg">
      <p class="sm:hidden text-xl font-domine my-4"><%= record %></p>

      <%= link_to "#", class: "link w-full" do %>
        <i class="fa-solid fa-clock mr-2"></i>
        View history
      <% end %>

      <%= link_to "#", class: "link w-full" do %>
        <i class="fa-regular fa-bookmark mr-2"></i>
        Add to watchlist
      <% end %>

      <%= link_to "#", class: "link w-full" do %>
        <i class="fa-regular fa-folder mr-2"></i>
        Add to collection
      <% end %>

      <%= render "shared/actions/buttons/add_to_stack", record: record %>

      <%= link_to "#", class: "link w-full" do %>
        <i class="fa-solid fa-share mr-2"></i>
        Share
      <% end %>

      <%= link_to "#", class: "link w-full" do %>
        <i class="fa-solid fa-flag mr-2"></i>
        Report
      <% end %>
    </div>
  </div>
<% end %>
