<%# NOTE: This is tested via system specs %>
<dialog
  data-controller="deletion-dialog"
  data-action="deletion-button:open@window->deletion-dialog#open"
  class="w-full max-w-full md:max-w-lg mt-auto md:m-auto open:flex open:flex-col open:gap-4 open:p-0 open:bg-transparent backdrop:backdrop-blur-sm">
  <div class="bg-background border-t-2 md:border-2 border-watch text-white md:rounded-lg relative">
    <div class="border-b-2 border-background-darker p-4 flex flex-wrap gap-2 justify-between items-center">
      <p class="font-domine text-xl">Are you sure you want to delete this?</p>
    </div>
    <div class="p-4">
      <p>This action cannot be undone.</p>
    </div>
    <div class="p-4 border-t-2 border-background-darker flex flex-wrap gap-2 justify-end">
      <button type="button" data-action="click->deletion-dialog#close" class="bg-background-darker rounded-lg py-2 px-4 cursor-pointer">No</button>
      <button type="button" data-action="click->deletion-dialog#submit" class="bg-watch rounded-lg py-2 px-4 cursor-pointer font-bold">Yes</button>
    </div>
  </div>
</dialog>
