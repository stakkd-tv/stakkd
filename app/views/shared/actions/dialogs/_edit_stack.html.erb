<%# NOTE: This is tested via system specs %>
<dialog
  data-controller="edit-stack-dialog"
  data-action="edit-stack-button:open@window->edit-stack-dialog#open"
  class="w-full max-w-full md:max-w-lg mt-auto md:m-auto open:flex open:flex-col open:gap-4 open:p-0 open:bg-transparent backdrop:backdrop-blur-sm overflow-hidden">
  <div class="bg-background border-t-2 md:border-2 border-watch text-white md:rounded-lg relative">
    <div class="border-b-2 border-background-darker p-4 flex flex-wrap gap-2 justify-between items-center">
      <p class="font-domine text-xl">Edit stack</p>
    </div>
    <%= form_for Stack.new, url: "", data: {edit_stack_dialog_target: "form", action: "submit->edit-stack-dialog#submit"}, html: {id: "edit_stack"} do |form| %>
      <div class="p-4">
        <div class="flex flex-col mb-4">
          <%= form.label :name, class: "text-sm mb-1" %>
          <%= form.text_field :name, class: "input text-sm" %>
          <small class="hidden" id="stack_name_error"></small>
        </div>

        <div class="flex flex-col mb-4">
          <%= form.label :description, class: "text-sm mb-1" %>
          <%= form.text_area :description, class: "input text-sm" %>
          <small class="hidden" id="stack_description_error"></small>
        </div>

        <div class="flex flex-col mb-4">
          <label class="text-sm mb-1" for="stack_sorting_method">Default sorting</label>
          <div class="flex gap-4">
            <%= form.select :sorting_method,
                  options_for_select(
                    Stack::SORTING_METHODS.map { [it.humanize, it] }
                  ),
                  {},
                  {class: "input text-sm"} %>
            <%= form.select :sorting_direction,
                  options_for_select(
                    Stack::SORTING_DIRECTIONS.map { [it.humanize, it] }
                  ),
                  {},
                  {class: "input text-sm w-fit"} %>
          </div>
        </div>

        <div data-controller="toggle"
          data-action="edit-stack-dialog:toggle@window->toggle#receiveDispatch"
          id="stack_private">
          <label class="text-sm mb-2">Private</label>
          <%= form.check_box :private, class: "hidden", autocomplete: "off", data: {toggle_target: "checkbox"} %>

          <div class="relative w-14 h-8 rounded-full cursor-pointer bg-background outline outline-pop transition-all duration-300 ease-in-out" data-toggle-target="toggleContainer" data-action="click->toggle#triggerToggle">
            <div class="w-6 h-6 rounded-full bg-white absolute top-1 left-1 transition-transform duration-300 ease-in-out" data-toggle-target="toggleHandle"></div>
          </div>
          <small class="inline-block mt-2">
            Private stacks can only be accessed by you.
            <% if current_user&.private? %>
              As your account is private, all your stacks will be private until you choose to make your account public.
            <% end %>
          </small>
        </div>
      </div>
      <div class="p-4 border-t-2 border-background-darker flex flex-wrap gap-2 justify-end">
        <button type="button" data-action="click->edit-stack-dialog#close" class="bg-background-darker rounded-lg py-2 px-4 cursor-pointer">Cancel</button>
        <input type="submit" value="Confirm" class="bg-watch rounded-lg py-2 px-4 cursor-pointer font-bold">
      </div>
    <% end %>
  </div>
</dialog>
