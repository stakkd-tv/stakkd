<div class="flex flex-nowrap gap-2 sm:gap-6 justify-between items-end" data-controller="jump-to">
  <% if presenter.previous_item %>
    <%= link_to presenter.previous_item_path, class: "link shrink-0", aria: {label: "Previous"} do %>
      <i class="fa-solid fa-arrow-left" aria-hidden="true"></i>
    <% end %>
  <% else %>
    <p class="font-bold cursor-default py-2 px-4 border border-gray-400 text-gray-400 rounded-lg text-sm text-center shrink-0" aria-label="Previous" aria-disabled="true">
      <i class="fa-solid fa-arrow-left" aria-hidden="true"></i>
    </p>
  <% end %>
  <div class="min-w-0 flex-1 flex flex-col items-center">
    <p class="font-domine mb-2">Jump to</p>
    <select
      class="jump_to w-full max-w-42"
      autocomplete="off"
      data-jump-to-target="select"
      name="jump_to"
      data-controller="slim-select"
      data-slim-select-searchable-value="false">
      <% presenter.items.each do |item| %>
        <option value="<%= item.path %>" <% if item.selected %> selected<% end %>><%= item.name %></option>
      <% end %>
    </select>
  </div>
  <% if presenter.next_item %>
    <%= link_to presenter.next_item_path, class: "link shrink-0", aria: {label: "Next"} do %>
      <i class="fa-solid fa-arrow-right" aria-hidden="true"></i>
    <% end %>
  <% else %>
    <p class="font-bold cursor-default py-2 px-4 border border-gray-400 text-gray-400 rounded-lg text-sm text-center shrink-0" aria-label="Next" aria-disabled="true">
      <i class="fa-solid fa-arrow-right" aria-hidden="true"></i>
    </p>
  <% end %>
</div>
