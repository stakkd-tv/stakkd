<div class="form">
  <%= render "form_nav", show: %>
  <%= form_with model: show do |form| %>
    <div class="flex flex-col xs:flex-row gap-6">
      <div class="basis-1/2">
        <%= form.label :translated_title %>
        <%= form.text_field :translated_title, required: true %>
      </div>

      <div class="basis-1/2">
        <%= form.label :original_title %>
        <%= form.text_field :original_title, required: true %>
      </div>
    </div>

    <div class="flex flex-col md:flex-row gap-6">
      <div class="basis-1/2">
        <%= form.label :language_id %>
        <%= form.collection_select :language_id,
              Language.order(:translated_name),
              :id,
              :translated_name,
              {},
              {class: "language_id", data: {controller: "slim-select"}, autocomplete: "off"} %>
      </div>

      <div class="basis-1/2">
        <%= form.label :country_id %>
        <%= form.collection_select :country_id,
              Country.order(:translated_name),
              :id,
              :translated_name,
              {},
              {class: "country_id", data: {controller: "slim-select"}, autocomplete: "off"} %>
      </div>
    </div>

    <div>
      <%= form.label :overview %>
      <%= form.text_area :overview, class: "h-60" %>
    </div>

    <div class="flex flex-col xs:flex-row gap-6">
      <div class="basis-1/2">
        <%= form.label :type %>
        <%= form.collection_select :type,
              Show::TYPES,
              :to_s,
              :humanize,
              {},
              {class: "type", data: {controller: "slim-select", slim_select_searchable_value: false}, autocomplete: "off"} %>
      </div>

      <div class="basis-1/2">
        <%= form.label :status %>
        <%= form.collection_select :status,
              Show::STATUSES.sort,
              :to_s,
              :humanize,
              {},
              {class: "status", data: {controller: "slim-select", slim_select_searchable_value: false}, autocomplete: "off"} %>
      </div>
    </div>

    <div class="flex flex-col xs:flex-row gap-6">
      <div class="basis-1/2">
        <%= form.label :imdb_id, "IMDB" %>
        <%= form.text_field :imdb_id %>
      </div>

      <div class="basis-1/2">
        <%= form.label :homepage %>
        <%= form.text_field :homepage %>
      </div>
    </div>

    <div>
      <%= form.submit "Save" %>
    </div>
  <% end %>
</div>
