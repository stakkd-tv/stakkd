<% content_for :title, "Stakkd - About" %>

<header class="relative bg-cover bg-no-repeat bg-center" style="background-image: url('<%= image_path "about-bg.jpg" %>')">
  <div class="bg-background/75 backdrop-blur-sm px-6 py-16 md:py-24">
    <div class="mx-auto max-w-2xl text-center text-white">
      <h1 class="mb-6 font-domine text-4xl font-bold">What is Stakkd?</h1>
      <p class="text-lg">Stakkd is an <strong>open source</strong> platform for tracking, discovering, and organizing your favorite movies and shows. Whether you're watching solo or planning a group movie night, Stakkd makes it easy to stay in sync.</p>
    </div>
  </div>
  <div aria-hidden="true" class="pointer-events-none absolute inset-x-0 -bottom-9 h-9 bg-contain opacity-75" style="background-image: url('<%= image_path "film.svg" %>');"></div>
</header>

<section class="mx-auto my-24 max-w-6xl px-6" aria-labelledby="about-features">
  <h2 id="about-features" class="mb-10 text-center font-domine text-4xl font-bold text-white">With Stakkd, you can</h2>

  <% features = [
    ["fa-square-check", "Track what you watch", "Log movies and episodes as you watch, then revisit your viewing history by movie, show, or season."],
    ["fa-magnifying-glass", "Discover your next watch", "Browse and filter movies and TV shows to find something you’re in the mood for."],
    ["fa-film", "Explore franchises", "See which titles belong to a franchise and find entries you’ve missed."],
    ["fa-list", "Browse official stacks", "Explore curated lists of movies and shows to find your next watch."],
    ["fa-layer-group", "Build shared watchlists", "Make a list for yourself or plan your next movie night together."],
    ["fa-square-poll-vertical", "Improve the catalog", "Contribute movie and TV data for the community to review."],
    ["fa-comments", "Rate and discuss", "Rate movies and shows, leave comments, and share your finds."],
    ["fa-puzzle-piece", "Connect your media apps", "Integrate Stakkd with your own media center or apps."],
    ["fa-server", "Self-host Stakkd", "Run your own instance with full data ownership and zero tracking."]
  ] %>

  <ul class="grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3">
    <% features.each do |icon, title, description| %>
      <li class="rounded-lg bg-pop/25 p-6 text-white">
        <div class="mb-3 flex items-center gap-3">
          <i aria-hidden="true" class="fa-solid <%= icon %> fa-fw text-xl"></i>
          <h3 class="font-domine text-xl font-bold"><%= title %></h3>
        </div>
        <p><%= description %></p>
      </li>
    <% end %>
  </ul>
</section>

<div class="bg-background-darker py-28 px-6">
  <h3 class="text-4xl font-bold font-domine text-white text-center mb-10">We've got some <span class="font-bold underline decoration-[5px] decoration-pop">awesome</span> contributors!</h3>
  <div class="max-w-6xl mx-auto my-20 px-6">
    <div class="grid grid-cols-1 sm:grid-cols-3 md:grid-cols-5 gap-4">
      <% @contributors.each do |contributor| %>
        <div class="col-span-1">
          <%= link_to contributor[:html_url] do %>
            <div class="bg-pop/25 rounded-lg w-full h-0 pb-[100%] overflow-hidden relative">
              <div class="absolute w-full h-full flex flex-col gap-2 justify-center items-center">
                <img src="<%= contributor[:avatar_url] %>" class="w-1/3 h-auto rounded-full">
                <p class="text-md font-bold"><%= contributor[:login] %></p>
              </div>
            </div>
          <% end %>
        </div>
      <% end %>
    </div>
  </div>
  <p class="text-center mt-10">Want your name on this list? We're always looking for contributors over on our <a href="https://github.com/stakkd-tv/stakkd" class="underline">Github page</a>.</p>
</div>
